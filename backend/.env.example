# Postgres connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/teamflow?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# CORS — comma-separated list of allowed origins (your frontend URL)
CORS_ORIGIN="http://localhost:5173,https://your-frontend.example.com"

# Port (Railway sets this automatically)
PORT=8080
